# --- Server ---
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://errances.socialmm.in,http://localhost:5173

# --- PostgreSQL ---
# Full connection string, e.g. postgres://user:password@host:5432/errances
DATABASE_URL=postgres://postgres:postgres@localhost:5432/errances
DATABASE_SSL=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Seed admin created on first boot if no staff exist yet
SEED_ADMIN_EMAIL=admin@errancesvoyages.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Administrator

# --- Cloudflare R2 (S3-compatible) file storage — optional ---
# Leave blank to fall back to storing images as base64 data URLs (legacy behaviour)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Twilio WhatsApp (used for automated lead conversation flow + manual sends) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
SKIP_TWILIO_VALIDATION=false

# --- Baileys WhatsApp Web bridge ---
ENABLE_BAILEYS=true
BAILEYS_AUTH_DIR=auth_info_baileys
