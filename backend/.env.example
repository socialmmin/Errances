# ErranceVoyages_Tourism_2026 — backend env vars (placeholders only, no real secrets)

PORT=4000
ALLOWED_ORIGIN=https://errances.socialmm.in

# Scoped app role, not the postgres superuser
DATABASE_URL=postgres://errance_app:CHANGE_ME@localhost:5432/errance

# JWT secrets — generate strong random values for real deployments
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible) — from Cloudflare dashboard > R2 > Manage API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=errance-storage

# Optional — live search integrations (search-only, no booking).
# Leave unset and the related endpoints/UI degrade gracefully.
LOCATIONIQ_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_FLIGHTS_HOST=
RAPIDAPI_TRAINS_HOST=
RAPIDAPI_HOTELS_HOST=

# Meta (Facebook/Instagram) Lead Ads webhook — see docs/meta-lead-ads-setup.md
# for how to obtain each value from Meta for Developers / Business Manager.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Optional — defaults to the first active branch if unset.
META_DEFAULT_BRANCH_ID=

# Web Push (VAPID) -- browser push notifications for new leads, even when
# the CRM tab/browser is closed. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@errances.socialmm.in
